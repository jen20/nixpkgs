+  /// The root of the toolchain that the *compiler* lives in.
+  ///
+  /// A Swift toolchain installs the driver next to `swift-frontend`, so this
+  /// is normally just the parent of the driver's own directory. Nixpkgs
+  /// installs them in separate store paths and points the driver at the
+  /// frontend through the environment; the compiler's plugins, in-process
+  /// plugin server and resource directories are all relative to the frontend,
+  /// not to the driver, so prefer that when it is set.
+  var compilerToolchainRoot: AbsolutePath {
+    get throws {
+      if compilerExecutableDir == nil,
+         let frontend = envVar(forExecutable: "swift-frontend"),
+         let frontendPath = try? AbsolutePath(validating: frontend) {
+        return frontendPath.parentDirectory.parentDirectory
+      }
+      return try executableDir.parentDirectory
+    }
+  }
+
