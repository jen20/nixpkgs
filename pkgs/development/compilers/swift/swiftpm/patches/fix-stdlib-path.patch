Swiftpm looks for the Swift stdlib relative to the swift compiler, but that's a
wrapper in our case. It wants to add the stdlib to the rpath, which is
necessary for back-deployment of some features.

diff --git a/Sources/PackageModel/Toolchain.swift b/Sources/PackageModel/Toolchain.swift
index d70a22e..4c79a80 100644
--- a/Sources/PackageModel/Toolchain.swift
+++ b/Sources/PackageModel/Toolchain.swift
@@ -158,7 +158,15 @@
     }
 
     package static func toolchainLibDir(swiftCompilerPath: AbsolutePath) throws -> AbsolutePath {
-        try AbsolutePath(validating: "../../lib", relativeTo: resolveSymlinks(swiftCompilerPath))
+        // The Swift compiler is a wrapper script in Nixpkgs, so the toolchain
+        // libraries are not located relative to it. Point at the compiler's
+        // `lib` output instead.
+        if swiftCompilerPath.pathString.starts(with: "@storeDir@") {
+            return try AbsolutePath(validating: "@swiftLib@/lib")
+        }
+        // Needs an explicit `return`: with the check above this is no longer a
+        // single-expression body.
+        return try AbsolutePath(validating: "../../lib", relativeTo: resolveSymlinks(swiftCompilerPath))
     }
 }
 
